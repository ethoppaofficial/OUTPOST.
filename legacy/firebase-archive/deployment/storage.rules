rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isLandlord() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'landlord'
        || isAdmin()
      );
    }

    function isStudent() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'student'
        || request.auth.token.get('role', '') == ''
      );
    }

    function validImage(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        && request.resource.size <= maxBytes;
    }

    function validDocument(maxBytes) {
      return (
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType == 'application/pdf'
      ) && request.resource.size <= maxBytes;
    }

    function validChatAttachment(maxBytes) {
      return (
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('text/.*')
      ) && request.resource.size <= maxBytes;
    }

    // ----------------------------------------------------------------------
    // System Healthchecks & Self-test
    // ----------------------------------------------------------------------
    match /_healthchecks/{uid}/{fileName} {
      allow read, write, delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Profile Pictures (public read, owner-only write, max 2MB image)
    // ----------------------------------------------------------------------
    match /profile-pictures/{uid}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(uid) || isAdmin())
        && validImage(2 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Legacy profile-images path
    match /profile-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(uid) || isAdmin())
        && validImage(2 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Student Verification Documents (private to student owner and admin)
    // Path: student-docs/{uid}/{docId}/{fileName}
    // ----------------------------------------------------------------------
    match /student-docs/{uid}/{docId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && validDocument(5 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Landlord Verification Documents (private to landlord owner and admin)
    // Path: landlord-docs/{uid}/{docId}/{fileName}
    // ----------------------------------------------------------------------
    match /landlord-docs/{uid}/{docId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && validDocument(5 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Tenant-Isolated Property Images
    // Path: property-images/{landlordId}/{propertyId}/{fileName}
    // Only the authenticated landlord owner or administrator can upload or delete.
    // ----------------------------------------------------------------------
    match /property-images/{landlordId}/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(landlordId) || isAdmin())
        && validImage(5 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.landlordId == landlordId;
      allow delete: if isOwner(landlordId) || isAdmin();
    }

    // Legacy property-images support (restricted: prevents cross-landlord overwrites)
    match /property-images/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        || (isLandlord() && (resource == null || resource.metadata.uploaderUid == request.auth.uid)
            && validImage(5 * 1024 * 1024)
            && request.resource.metadata.uploaderUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isLandlord() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Tenant-Isolated Payment Receipts
    // Path: payment-receipts/{landlordId}/{studentId}/{reservationId}/{fileName}
    // Read: ONLY the specific student, the specific landlord, or an administrator.
    // Write: ONLY the specific student submitting for their own reservation.
    // ----------------------------------------------------------------------
    match /payment-receipts/{landlordId}/{studentId}/{reservationId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && (isOwner(studentId) || isOwner(landlordId)));
      allow write: if (isOwner(studentId) || isAdmin())
        && validDocument(5 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.studentId == studentId
        && request.resource.metadata.landlordId == landlordId
        && request.resource.metadata.reservationId == reservationId;
      allow delete: if isAdmin() || isOwner(studentId);
    }

    // Legacy payment-receipts path (HARDENED: Removed arbitrary landlord read)
    match /payment-receipts/{reservationId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // Legacy receipts path (HARDENED: Removed arbitrary landlord read)
    match /receipts/{reservationId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    match /receipts/{reservationId}/{receiptId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Sender-Isolated Chat Attachments
    // Path: chat-attachments/{conversationId}/{senderId}/{fileName}
    // Read: Only the sender or administrator (private attachment).
    // Write: Only the authenticated sender.
    // ----------------------------------------------------------------------
    match /chat-attachments/{conversationId}/{senderId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && isOwner(senderId));
      allow write: if (isOwner(senderId) || isAdmin())
        && validChatAttachment(5 * 1024 * 1024)
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.senderId == senderId
        && request.resource.metadata.conversationId == conversationId;
      allow delete: if isAdmin() || isOwner(senderId);
    }

    // Legacy chat-attachments path (HARDENED: Removed broad signedIn read)
    match /chat-attachments/{chatId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validChatAttachment(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Default-deny all other paths
    // ----------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
