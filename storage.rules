rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isLandlord() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'landlord'
        || request.auth.token.get('admin', false) == true
      );
    }

    function validImage(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        && request.resource.size <= maxBytes;
    }

    function validDocument(maxBytes) {
      return (
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType == 'application/pdf'
      ) && request.resource.size <= maxBytes;
    }

    function validChatAttachment(maxBytes) {
      return (
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('text/.*')
      ) && request.resource.size <= maxBytes;
    }

    // ----------------------------------------------------------------------
    // System Healthchecks & Self-test
    // Path: _healthchecks/{uid}/{fileName}
    // ----------------------------------------------------------------------
    match /_healthchecks/{uid}/{fileName} {
      allow read, write, delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Profile Pictures
    // Path: profile-pictures/{uid}/{fileName} (images only, max 2 MB)
    // ----------------------------------------------------------------------
    match /profile-pictures/{uid}/{fileName} {
      allow read: if true; // Publicly readable for avatars
      allow write: if (isOwner(uid) || isAdmin()) && validImage(2 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Legacy profile-images path support
    match /profile-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if (isOwner(uid) || isAdmin()) && validImage(2 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Student Verification Documents
    // Path: student-docs/{uid}/{docId}/{fileName} (image or PDF, max 5 MB)
    // ----------------------------------------------------------------------
    match /student-docs/{uid}/{docId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) && validDocument(5 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Landlord Verification Documents
    // Path: landlord-docs/{uid}/{docId}/{fileName} (image or PDF, max 5 MB)
    // ----------------------------------------------------------------------
    match /landlord-docs/{uid}/{docId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) && validDocument(5 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Property Images
    // Path: property-images/{propertyId}/{fileName} (images only, max 5 MB)
    // Only landlords or administrators can upload property media.
    // Deletion is restricted to the uploader landlord or an administrator.
    // ----------------------------------------------------------------------
    match /property-images/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if (isLandlord() || isAdmin()) && validImage(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (isLandlord() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Payment Receipts
    // Path: payment-receipts/{reservationId}/{fileName} (image or PDF, max 5 MB)
    // Read: Only the uploading student, property landlords, or administrators.
    // Write: Signed-in students tagging their own uploader UID.
    // Delete: Only the student owner or administrator.
    // ----------------------------------------------------------------------
    match /payment-receipts/{reservationId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && (resource.metadata.uploaderUid == request.auth.uid || isLandlord()));
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // Legacy receipts path support with strict access
    match /receipts/{reservationId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && (resource.metadata.uploaderUid == request.auth.uid || isLandlord()));
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    match /receipts/{reservationId}/{receiptId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn() && (resource.metadata.uploaderUid == request.auth.uid || isLandlord()));
      allow write: if signedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid
        && validDocument(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Chat Attachments
    // Path: chat-attachments/{chatId}/{fileName} (max 5 MB)
    // ----------------------------------------------------------------------
    match /chat-attachments/{chatId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validChatAttachment(5 * 1024 * 1024);
      allow delete: if isAdmin()
        || (signedIn() && resource.metadata.uploaderUid == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Deny every other path by default
    // ----------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
