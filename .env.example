# ============================================================================
# OUTPOST ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.local and fill in your credentials.
# Never commit real secrets or private keys to version control.
# ============================================================================

# Backend Mode: 'firebase' | 'supabase' | 'mock'
VITE_BACKEND_MODE=
VITE_USE_BACKEND=
VITE_ENABLE_DEMO_MODE=

# Supabase Configuration (Vite & Next-compatible prefixes)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase Configuration (Retained for rollback until Supabase parity is verified)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_KEY=

# MapLibre / MapTiler Public Client Key (Restrict by domain & quota)
VITE_MAPTILER_API_KEY=
