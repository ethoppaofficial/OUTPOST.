# ============================================================================
# OUTPOST ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your Supabase credentials.
# Never commit real secrets or private keys to version control.
# ============================================================================

# Supabase Client Configuration (Vite canonical)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# MapLibre / MapTiler Public Client Key (Optional - domain-restricted)
VITE_MAPTILER_API_KEY=
