rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isLandlord() {
      return isAuthenticated() && (
        request.auth.token.role == 'landlord' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'landlord'
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        request.auth.token.role == 'student' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only admins or the user themselves can update account profile
      allow write: if isOwner(userId) || isAdmin();
    }

    // Student Profiles & Documents
    match /studentProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Sensitive Student Verification Documents (Strict Private Access)
    match /studentVerificationDocuments/{docId} {
      // ONLY the student owner and platform administrators can view verification documents
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      // Students can upload documents for review
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Only administrators can approve, reject, or update review status
      allow update, delete: if isAdmin();
    }

    // Landlord Profiles & Verifications
    match /landlordProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Properties: Public approved listings readable by all; landlords manage their own; admin verifies
    match /properties/{propertyId} {
      allow read: if resource.data.verificationStatus == 'approved' || (isAuthenticated() && (resource.data.landlordId == request.auth.uid || isAdmin()));
      allow create: if isLandlord() && request.resource.data.landlordId == request.auth.uid;
      allow update: if (isLandlord() && resource.data.landlordId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reservations & Holds
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Status changes must be authorized: student can cancel, landlord can verify receipt, admin can expire
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isLandlord()
      );
      allow write: if isAdmin();
    }

    // Payment Receipts (Strict Landlord & Student Only)
    match /paymentReceipts/{receiptId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Landlords can approve/reject receipts for their properties; Admins have super-audit
      allow update: if isAuthenticated() && (
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // Roommate Preferences & Requests
    match /roommatePreferences/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /roommateRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStudent() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // Accommodation Groups
    match /accommodationGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow delete: if isAuthenticated() && (resource.data.leaderId == request.auth.uid || isAdmin());
    }

    // Real-Time Chat & Conversations (Strict Participant Access)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated(); // or triggered via backend functions
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
