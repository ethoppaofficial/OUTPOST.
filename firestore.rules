rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ethoppaofficial@gmail.com' ||
        request.auth.token.email == 'admin@outpost.ng' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isLandlord() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'landlord'
      );
    }

    function isStudent() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
      );
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Student Profiles & Documents
    match /studentProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Sensitive Student Verification Documents (Strict Private Access)
    match /studentVerificationDocuments/{docId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Landlord Profiles & Verifications
    match /landlordProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Properties: Public approved listings readable by all; landlords manage their own; admin verifies
    match /properties/{propertyId} {
      allow read: if resource.data.verificationStatus == 'approved' || (isSignedIn() && (resource.data.landlordId == request.auth.uid || isAdmin()));
      allow create: if (isLandlord() || isAdmin()) && request.resource.data.landlordId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.landlordId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reservations & Holds
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.landlordId == request.auth.uid);
    }

    // Payment Receipts (Strict Landlord & Student Only)
    match /paymentReceipts/{receiptId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // Roommate Preferences & Requests
    match /roommatePreferences/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /roommateRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // Accommodation Groups
    match /accommodationGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.leaderId == request.auth.uid ||
        (resource.data.adminIds != null && request.auth.uid in resource.data.adminIds) ||
        request.auth.uid in resource.data.memberIds ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.leaderId == request.auth.uid || isAdmin());
    }

    // Group Join Requests
    match /groupJoinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/accommodationGroups/$(resource.data.groupId)).data.memberIds
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/accommodationGroups/$(resource.data.groupId)).data.memberIds
      );
      allow delete: if isAdmin();
    }

    // Real-Time Chat & Conversations (Strict Participant Access)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    // Messages with participant-checked read, strict sender creation, and 15-min author-only edit
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin() ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds
      );
      allow create: if isSignedIn() && 
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Sender editing within 15 minutes, preserving sender and conversation identity
        (
          resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.conversationId == resource.data.conversationId
        ) ||
        // Or marking as read by a participant
        (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryStatus', 'readAt', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Typing and Presence indicators
    match /typingStates/{stateId} {
      allow read, write: if isSignedIn();
    }

    match /presenceStates/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
